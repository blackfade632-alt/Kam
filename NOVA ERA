local meteorRunning = false
local function spawnMeteor(position)
    local meteor = Instance.new("Part")
    meteor.Name = "KamuiMeteor"
    meteor.Shape = Enum.PartType.Ball
    meteor.Size = Vector3.new(8, 8, 8)
    meteor.Material = Enum.Material.Neon
    meteor.BrickColor = BrickColor.new("Really red")
    meteor.CanCollide = true
    meteor.Position = Vector3.new(position.X + math.random(-200, 200), position.Y + 400, position.Z + math.random(-200, 200))
    meteor.Parent = workspace
    local fire = Instance.new("Fire")
    fire.Heat = 50
    fire.Size = 20
    fire.Parent = meteor
    local light = Instance.new("PointLight")
    light.Brightness = 5
    light.Range = 40
    light.Color = Color3.fromRGB(255, 100, 0)
    light.Parent = meteor
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.new(math.random(-50, 50), -300, math.random(-50, 50))
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Parent = meteor
    task.delay(8, function() if meteor and meteor.Parent then meteor:Destroy() end end)
    meteor.Touched:Connect(function()
        if meteor:GetAttribute("Exploded") then return end
        meteor:SetAttribute("Exploded", true)
        local explosion = Instance.new("Explosion")
        explosion.Position = meteor.Position
        explosion.BlastRadius = 20
        explosion.BlastPressure = 50000
        explosion.Parent = workspace
        if meteor.Parent then meteor:Destroy() end
    end)
end

local function startMeteor(target)
    if meteorRunning then return end
    meteorRunning = true
    task.spawn(function()
        while meteorRunning do
            local pos
            if target and target.Character then
                local hrp = target.Character:FindFirstChild("HumanoidRootPart")
                if hrp then pos = hrp.Position end
            end
            if not pos then pos = Vector3.new(math.random(-300, 300), 100, math.random(-300, 300)) end
            spawnMeteor(pos)
            task.wait(0.5)
        end
    end)
end

local function stopMeteor()
    meteorRunning = false
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name == "KamuiMeteor" then obj:Destroy() end
    end
end

