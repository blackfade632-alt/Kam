local function applyTag(player)
    if not player or player == LocalPlayer then return end
    if not isAdminAuthorized(LocalPlayer) then return end
    if player:GetAttribute("KamuiHubUser") ~= true then return end
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    local old = head:FindFirstChild("KamuiTag")
    if old then old:Destroy() end
    local isAdm = isAdminAuthorized(player)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "KamuiTag"
    billboard.Size = UDim2.new(0, 120, 0, 25)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundColor3 = isAdm and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
    label.BackgroundTransparency = 0.2
    label.BorderSizePixel = 0
    label.Text = isAdm and "[ADMIN]" or "[USUÁRIO]"
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextScaled = true
    label.Font = Enum.Font.SourceSansBold
    label.Parent = billboard
end

local function hookTags()
    if not isAdminAuthorized(LocalPlayer) then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then applyTag(p) end
    end
    Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function() task.wait(1.5) applyTag(p) end)
        task.wait(2)
        applyTag(p)
    end)
end

