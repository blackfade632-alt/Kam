local function removeAllTags()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local tag = head:FindFirstChild("KamuiTag")
                if tag then tag:Destroy() end
            end
        end
    end
end

local function hookTags()
    tagsActive = true
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then applyTag(p) end
    end
    Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function() task.wait(1.5) if tagsActive then applyTag(p) end end)
        task.wait(2)
        if tagsActive then applyTag(p) end
    end)
end

