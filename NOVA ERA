    floor.Position = origin
    floor.Anchored = true
    floor.BrickColor = BrickColor.new("New Yeller")
    floor.Material = Enum.Material.Concrete
    floor.Parent = folder
    local ceiling = Instance.new("Part")
    ceiling.Name = "Ceiling"
