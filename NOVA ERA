-- BACKROOMS (maze real com paredes consistentes)
-- ============================================================
local function createBackrooms()
    local existing = workspace:FindFirstChild("KamuiBackrooms")
    if existing then existing:Destroy() end

    local folder = Instance.new("Folder")
    folder.Name = "KamuiBackrooms"
    folder.Parent = workspace

    local gridSize = 6
    local cellSize = 40
    local wallHeight = 14
    local wallThickness = 2
    local origin = Vector3.new(0, BACKROOMS_Y, 0)

    -- Gera matriz de paredes (maze simples)
    -- hWalls[x][z] = parede horizontal entre (x,z) e (x+1,z)
    -- vWalls[x][z] = parede vertical entre (x,z) e (x,z+1)
    local hWalls = {}
    local vWalls = {}
    for x = 1, gridSize do
        hWalls[x] = {}
        vWalls[x] = {}
        for z = 1, gridSize do
            hWalls[x][z] = false
            vWalls[x][z] = false
        end
    end

    -- Borda externa sempre com parede
    for x = 1, gridSize do
        hWalls[x][gridSize] = true
        hWalls[x][1] = true
        vWalls[x][gridSize] = true
        vWalls[x][1] = true
    end
    for z = 1, gridSize do
        hWalls[gridSize][z] = true
        hWalls[1][z] = true
        vWalls[gridSize][z] = true
        vWalls[1][z] = true
    end

    -- Paredes internas aleatórias (60% chance)
    for x = 1, gridSize - 1 do
        for z = 1, gridSize - 1 do
            if math.random() > 0.4 then
                hWalls[x][z] = true
            end
            if math.random() > 0.4 then
                vWalls[x][z] = true
            end
        end
    end

    -- Chão (carpete amarelo)
    for x = 1, gridSize do
        for z = 1, gridSize do
            local tile = Instance.new("Part")
            tile.Name = "Floor"
            tile.Size = Vector3.new(cellSize, 1, cellSize)
            tile.Position = origin + Vector3.new((x - gridSize/2 - 0.5) * cellSize, 0, (z - gridSize/2 - 0.5) * cellSize)
            tile.Anchored = true
            tile.BrickColor = BrickColor.new("Cool yellow")
            tile.Material = Enum.Material.Fabric
            tile.Parent = folder
        end
    end

    -- Teto
    local ceiling = Instance.new("Part")
    ceiling.Name = "Ceiling"
    ceiling.Size = Vector3.new(gridSize * cellSize, 1, gridSize * cellSize)
    ceiling.Position = origin + Vector3.new(0, wallHeight, 0)
    ceiling.Anchored = true
    ceiling.BrickColor = BrickColor.new("Cool yellow")
    ceiling.Material = Enum.Material.SmoothPlastic
    ceiling.Parent = folder

    -- Constrói paredes horizontais
    for x = 1, gridSize do
        for z = 1, gridSize do
            if hWalls[x][z] then
                local wall = Instance.new("Part")
                wall.Name = "Wall"
                wall.Size = Vector3.new(cellSize + wallThickness, wallHeight, wallThickness)
                wall.Position = origin + Vector3.new(
                    (x - gridSize/2 - 0.5) * cellSize,
                    wallHeight / 2,
                    (z - gridSize/2) * cellSize
                )
                wall.Anchored = true
                wall.BrickColor = BrickColor.new("Cool yellow")
                wall.Material = Enum.Material.SmoothPlastic
                wall.Parent = folder
            end
        end
    end

    -- Constrói paredes verticais
    for x = 1, gridSize do
        for z = 1, gridSize do
            if vWalls[x][z] then
                local wall = Instance.new("Part")
                wall.Name = "Wall"
                wall.Size = Vector3.new(wallThickness, wallHeight, cellSize + wallThickness)
                wall.Position = origin + Vector3.new(
                    (x - gridSize/2) * cellSize,
                    wallHeight / 2,
                    (z - gridSize/2 - 0.5) * cellSize
                )
                wall.Anchored = true
                wall.BrickColor = BrickColor.new("Cool yellow")
                wall.Material = Enum.Material.SmoothPlastic
                wall.Parent = folder
            end
        end
    end

    -- Lâmpadas fluorescentes
    for i = 1, 10 do
        local lamp = Instance.new("Part")
        lamp.Name = "Lamp"
        lamp.Size = Vector3.new(8, 0.3, 2)
        lamp.Position = origin + Vector3.new(
            math.random(-gridSize * 15, gridSize * 15),
            wallHeight - 1.5,
            math.random(-gridSize * 15, gridSize * 15)
        )
        lamp.Anchored = true
        lamp.CanCollide = false
        lamp.Material = Enum.Material.Neon
        lamp.BrickColor = BrickColor.new("Toothpaste")
        lamp.Parent = folder
        local pl = Instance.new("PointLight")
        pl.Brightness = 3
        pl.Range = 50
        pl.Color = Color3.fromRGB(255, 250, 180)
        pl.Parent = lamp
    end
end

