local MUSIC_FILE = "kamui_saved_music.json"
local savedMusic = {}
if FILE_API_OK then
    pcall(function()
        if isfile(MUSIC_FILE) then
            local raw = readfile(MUSIC_FILE)
            if raw and raw ~= "" then
                local data = HttpService:JSONDecode(raw)
                if type(data) == "table" then
                    for k, v in pairs(data) do
                        local clean = tostring(v):match("(%d+)")
                        if clean then savedMusic[k] = clean end
                    end
                end
            end
        end
    end)
end

local function persistMusic()
    if not FILE_API_OK then return end
    pcall(function() writefile(MUSIC_FILE, HttpService:JSONEncode(savedMusic)) end)
end

local function normalizeId(id)
    if not id then return nil end
    id = tostring(id):gsub("%s+", "")
    return id:match("(%d+)")
end

